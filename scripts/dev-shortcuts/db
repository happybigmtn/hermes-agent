#!/usr/bin/env bash
set -euo pipefail
"$HOME/.hermes/scripts/dev-run-status.py" >/dev/null || true
if [ -n "${HERMES_DEV_RUN_STATUS_DASHBOARD_URL:-}" ]; then
  echo "$HERMES_DEV_RUN_STATUS_DASHBOARD_URL"
  exit 0
fi
ip="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
if [ -n "$ip" ]; then
  echo "http://${ip}:8765/dev-run-status-latest.html"
else
  echo "$HOME/.hermes/reports/dev-run-status-latest.html"
fi
