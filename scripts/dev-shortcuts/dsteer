#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: dsteer <repo> "<message>" ["intent"]

Examples:
  dsteer nullspaceton "If auto gen is stalled, write closeout and stop cleanly."
  dsteer ludeme "Summarize current blocker." "Ask Ludeme worker for blocker summary"

Optional:
  DSESSION=<session> dsteer <repo> "<message>" ["intent"]

Default session: <repo>-codex
Refuses if the session does not exist.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "$#" -lt 2 ]; then
  usage
  exit 0
fi

repo_arg="$1"
message="$2"
intent="${3:-Steer worker: ${message:0:140}}"

if [ -d "$repo_arg" ]; then
  repo="$(cd "$repo_arg" && pwd)"
elif [ -d "/srv/dev/repos/$repo_arg" ]; then
  repo="/srv/dev/repos/$repo_arg"
else
  echo "repo not found: $repo_arg" >&2
  exit 2
fi

slug="$(basename "$repo")"
session="${DSESSION:-${slug}-codex}"

if ! tmux has-session -t "$session" 2>/dev/null; then
  cat >&2 <<EOF
session does not exist: $session

Use:
  dnew $slug "<intent>"
  dw
EOF
  exit 3
fi

exec "$HOME/.hermes/scripts/dev-worker-dispatch.py" \
  --repo "$repo" \
  --session "$session" \
  --intent "$intent" \
  --event-type worker-steer \
  --no-start-if-missing \
  --message "$message"
