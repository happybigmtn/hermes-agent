#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: dnew <repo> "<intent>" [command]

Create a new supervised worker. Refuses if the session already exists.

Examples:
  dnew ludeme "Continue the Ludeme campaign from the current plan"
  dnew nullspaceton "Run the WATER slice" "codex --yolo"

Optional:
  DSESSION=<session> dnew <repo> "<intent>" [command]

Default command: codex --yolo
Default session: <repo>-codex
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "$#" -lt 2 ]; then
  usage
  exit 0
fi

repo_arg="$1"
intent="$2"
shift 2
message="${*:-codex --yolo}"

if [ -d "$repo_arg" ]; then
  repo="$(cd "$repo_arg" && pwd)"
elif [ -d "/srv/dev/repos/$repo_arg" ]; then
  repo="/srv/dev/repos/$repo_arg"
else
  echo "repo not found: $repo_arg" >&2
  exit 2
fi

slug="$(basename "$repo")"
session="${DSESSION:-${slug}-codex}"

if tmux has-session -t "$session" 2>/dev/null; then
  cat >&2 <<EOF
session already exists: $session

Use:
  dsteer $slug "<message>"
  dtail $slug
  dattach $slug
  dclose $slug
EOF
  exit 3
fi

exec "$HOME/.hermes/scripts/dev-worker-dispatch.py" \
  --repo "$repo" \
  --session "$session" \
  --intent "$intent" \
  --event-type worker-start \
  --message "$message"
